<odoo>

    <!-- Déclaration du rapport XLSX pour le wizard -->
    <record id="action_pos_payment_vat_xlsx" model="ir.actions.report">
        <field name="name">Rapport TVA par Mode de Paiement (XLSX)</field>
        <field name="model">pos.payment.vat.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">pos.payment.vat.wizard.xlsx</field>
        <field name="report_file">pos_payment_vat_report</field>
        <field name="print_report_name">'Rapport_TVA_Mode_Paiement_%s_%s' % (object.date_from, object.date_to)</field>
    </record>

</odoo>
