#. module: pos_settle_customer_account
#: model:mail.template,body_html:pos_settle_customer_account.email_template_edi_invoice
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"box-sizing:border-box;margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            <t t-out=\"(object.partner_id.name or '').strip()\">Brandon Freeman</t>\n"
"                            (<t t-out=\"(object.partner_id.parent_id.name or '').strip()\">Azure Interior</t>),\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"(object.partner_id.name or '').strip()\">Brandon Freeman</t>,\n"
"                        </t>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        Here is your\n"
"                        <t t-if=\"object.name\">\n"
"                            invoice\n"
"                            <span style=\"font-weight:bold;\" t-out=\"(object.name or '').strip()\">INV/2021/05/0005</span>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            invoice\n"
"                        </t>\n"
"                        <t t-if=\"object.invoice_origin\">\n"
"                            (with reference: <t t-out=\"(object.invoice_origin or '').strip()\">SUB003</t>)\n"
"                        </t>\n"
"                        amounting in\n"
"                        <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 143,750.00\n"
"                        </span>\n"
"                        from <t t-out=\"(object.company_id.name or '').strip()\">YourCompany</t>.\n"
"                        <t t-if=\"object.payment_state in ('paid', 'in_payment')\">\n"
"                            This invoice is already paid.\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            Please remit payment at your earliest convenience.\n"
"                            <t t-if=\"object.payment_reference\">\n"
"                                <br/>\n"
"                                <br/>\n"
"                                Please use the following communication for your payment:\n"
"                                <span style=\"font-weight:bold;\" t-out=\"(object.payment_reference or '').strip()\">\n"
"                                    INV/2021/05/0005</span>.\n"
"                            </t>\n"
"                        </t>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        Do not hesitate to contact us if you have any questions.\n"
"                        <t t-if=\"not is_html_empty(object.invoice_user_id.signature)\" data-o-mail-quote-container=\"1\">\n"
"                            <br/>\n"
"                            <br/>\n"
"                            <t t-out=\"object.invoice_user_id.signature or ''\" data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/>Mitchell Admin\n"
"                            </t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"box-sizing:border-box;margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Bonjour\n"
"                        <t t-if=\"object.partner_id.parent_id\">\n"
"                            <t t-out=\"(object.partner_id.name or '').strip()\">Brandon Freeman</t>\n"
"                            (<t t-out=\"(object.partner_id.parent_id.name or '').strip()\">Azure Interior</t>),\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-out=\"(object.partner_id.name or '').strip()\">Brandon Freeman</t>,\n"
"                        </t>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        Voici votre\n"
"                        <t t-if=\"object.name\">\n"
"                            facture\n"
"                            <span style=\"font-weight:bold;\" t-out=\"(object.name or '').strip()\">INV/2021/05/0005</span>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            facture\n"
"                        </t>\n"
"                        <t t-if=\"object.invoice_origin\">\n"
"                            (avec référence : <t t-out=\"(object.invoice_origin or '').strip()\">SUB003</t>)\n"
"                        </t>\n"
"                        d'un montant de\n"
"                        <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 143 750,00\n"
"                        </span>\n"
"                        de la part de <t t-out=\"(object.company_id.name or '').strip()\">YourCompany</t>.\n"
"                        <t t-if=\"object.payment_state in ('paid', 'in_payment')\">\n"
"                            Cette facture est déjà payée.\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            Veuillez effectuer le paiement dès que possible.\n"
"                            <t t-if=\"object.payment_reference\">\n"
"                                <br/>\n"
"                                <br/>\n"
"                                Veuillez utiliser la communication suivante pour votre paiement :\n"
"                                <span style=\"font-weight:bold;\" t-out=\"(object.payment_reference or '').strip()\">\n"
"                                    INV/2021/05/0005</span>.\n"
"                            </t>\n"
"                        </t>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        N'hésitez pas à nous contacter si vous avez des questions.\n"
"                        <t t-if=\"not is_html_empty(object.invoice_user_id.signature)\" data-o-mail-quote-container=\"1\">\n"
"                            <br/>\n"
"                            <br/>\n"
"                            <t t-out=\"object.invoice_user_id.signature or ''\" data-o-mail-quote=\"1\">--<br data-o-mail-quote=\"1\"/>Mitchell Admin\n"
"                            </t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

